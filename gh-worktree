#!/usr/bin/env bash

[ -z "${DEBUG:-}" ] || set -x

set -euo pipefail

_gh_worktree_source_dir=$(dirname "${BASH_SOURCE[0]}")

# Verify required dependencies are installed
#
# Checks that Bash 4.4+, gh, gum, and jq are available.
# Prints installation instructions and exits if any are missing.
_check_dependencies() {
	if [[ "${BASH_VERSINFO[0]}" -lt 4 || ("${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 4) ]]; then
		echo "gh-worktree: requires Bash 4.4+ (found ${BASH_VERSION})" >&2
		echo "  macOS: brew install bash" >&2
		exit 1
	fi

	local missing=()

	if ! command -v gh &>/dev/null; then
		missing+=("gh   — https://cli.github.com")
	fi
	if ! command -v gum &>/dev/null; then
		missing+=("gum  — https://github.com/charmbracelet/gum")
	fi
	if ! command -v jq &>/dev/null; then
		missing+=("jq   — https://jqlang.github.io/jq")
	fi

	if [[ ${#missing[@]} -gt 0 ]]; then
		echo "gh-worktree: missing required dependencies:" >&2
		for dep in "${missing[@]}"; do
			echo "  $dep" >&2
		done
		exit 1
	fi
}

_check_dependencies

# Source command modules
# shellcheck source=scripts/gh_worktree.sh
source "$_gh_worktree_source_dir/scripts/gh_worktree.sh"
# shellcheck source=scripts/gh_pr.sh
source "$_gh_worktree_source_dir/scripts/gh_pr.sh"
# shellcheck source=scripts/gh_issue.sh
source "$_gh_worktree_source_dir/scripts/gh_issue.sh"
# shellcheck source=scripts/gh_run.sh
source "$_gh_worktree_source_dir/scripts/gh_run.sh"

_show_help() {
	cat <<'EOF'
gh worktree — spin up isolated git worktrees for pull requests, issues, and workflow runs

USAGE:
    gh worktree pr <number>    [-- <command>]
    gh worktree issue <number> [-- <command>]
    gh worktree run <id>       [-- <command>]

DESCRIPTION:
    Creates a git worktree for the given GitHub resource, runs the command
    inside it (or opens $SHELL when no command is given), then removes the
    worktree on exit.

COMMANDS:
    pr      Open an isolated worktree for a pull request
    issue   Open an isolated worktree for an issue
    run     Open an isolated worktree for a workflow run

FLAGS:
    -V, --version   Print version

SEE ALSO:
    gh worktree pr --help      # PR worktree usage
    gh worktree issue --help   # Issue worktree usage
    gh worktree run --help     # Run worktree usage
EOF
}

_show_version() {
	cat "$_gh_worktree_source_dir/version.txt"
}

main() {
	local command="${1:-}"
	shift || true

	case "$command" in
	pr)
		_gh_pr_exec "$@"
		;;
	issue)
		_gh_issue_exec "$@"
		;;
	run)
		_gh_run_exec "$@"
		;;
	--version | -V)
		_show_version
		;;
	--help | -h | help | "")
		_show_help
		;;
	*)
		gum log --level error "Unknown command '$command'"
		gum log --level info "Available commands: pr, issue, run"
		gum log --level info "Run 'gh worktree --help' for usage information"
		exit 1
		;;
	esac
}

main "$@"
